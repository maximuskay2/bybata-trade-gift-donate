# Local development only. Never use the production database or credentials.
NODE_ENV=development
PORT=3000
API_PORT=3000
DATABASE_URL=postgresql://bybata:replace-me@localhost:5432/bybata?schema=public
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
CONFIG_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3001,http://localhost:8080
API_PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:8080
ADMIN_URL=http://localhost:3001
REDIS_URL=redis://:replace-me@localhost:6379
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=bybata
STORAGE_ACCESS_KEY_ID=bybata
STORAGE_SECRET_ACCESS_KEY=replace-me
STORAGE_CDN_BASE_URL=http://localhost:9000/bybata
# Optional features. Configure only isolated development/sandbox services.
OPENAI_API_KEY=
AI_INTENT_ENABLED=false
AI_INTENT_MODEL=gpt-4o-mini
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYSTACK_SECRET=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
FLW_SECRET_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
WELCOME_EMAIL_ENABLED=false
MESSAGING_SMS_ENABLED=false
MESSAGING_WHATSAPP_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
SENTRY_DSN=

# PayPal trade top-up (sandbox first). Server only, never commit real values.
