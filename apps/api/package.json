{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "prisma generate",
    "start:prod": "node dist/src/main.js",
    "postinstall": "prisma generate",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --port 5555",
    "db:migrate:dev": "node -e \"require('dotenv').config({path:'.env.development'}); require('child_process').execSync('npx prisma migrate deploy', {stdio:'inherit', env:process.env})\"",
    "db:migrate:prod": "node -e \"require('dotenv').config({path:'.env.production'}); require('child_process').execSync('npx prisma migrate deploy', {stdio:'inherit', env:process.env})\"",
    "scenario:negotiations": "ts-node -r dotenv/config scripts/reset_and_setup_negotiations.ts",
    "list:pending:gift-requests": "ts-node -r dotenv/config scripts/list_pending_gift_requests.ts",
    "scenario:gift-flow": "ts-node -r dotenv/config scripts/seed_gift_flow_carol_alice.ts",
    "verify:single-pending-claim": "ts-node -r dotenv/config scripts/verify_single_pending_claim.ts",
    "seed:gifts-with-images": "ts-node -r dotenv/config scripts/seed_gifts_with_images.ts",
    "purge:listings:dry-run": "ts-node -r dotenv/config scripts/purge-listing-data.ts --dry-run",
    "purge:listings": "ts-node -r dotenv/config scripts/purge-listing-data.ts --confirm PURGE_PRODUCTION",
    "media:backfill-variants": "ts-node -r dotenv/config scripts/backfill-listing-media-variants.ts",
    "media:backfill-variants:dry-run": "ts-node -r dotenv/config scripts/backfill-listing-media-variants.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@aws-sdk/s3-request-presigner": "^3.901.0",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.16.3",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "apple-signin-auth": "^2.0.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^6.0.0",
    "cache-manager-ioredis-yet": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.5.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "isomorphic-dompurify": "^2.34.0",
    "jimp": "^0.22.12",
    "nodemailer": "^6.10.1",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.13.0",
    "prisma": "^6.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
